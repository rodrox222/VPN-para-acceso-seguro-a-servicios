# QA001 / HU-11 — Configuración de las mediciones
# Copiar a config.env y ajustar:   cp config.env.example config.env
# (config.env queda fuera de Git gracias a la regla *.env del .gitignore)

# Etiqueta del entorno: local | aws   (se usa en el nombre de la carpeta de resultados)
ENTORNO=local

# IP REAL del servidor, la que se alcanza SIN la VPN:
#   local -> IP de la VM en la red solo-anfitrión (ej. 192.168.221.128)
#   aws   -> IP pública (Elastic IP) de la instancia EC2
IP_SIN_VPN=192.168.221.128

# Solo para el SERVIDOR: IP en la que publica la API temporal. Por defecto es IP_SIN_VPN.
#   local -> dejar comentado
#   aws   -> IP PRIVADA de la instancia (la pública no pertenece a su interfaz de red)
#BIND_SIN_VPN=172.31.0.10

# IP del servidor DENTRO del túnel
IP_CON_VPN=10.0.0.1

# Puertos
PUERTO_API_VPN=5000        # API real (docker compose), solo escucha en IP_CON_VPN
PUERTO_API_SIN_VPN=5001    # API temporal de línea base, solo escucha en IP_SIN_VPN
PUERTO_IPERF=5201

# Cuántas veces se repite todo (más corridas = números más confiables)
RUNS=10
PING_COUNT=100             # paquetes ICMP por corrida (a 5 por segundo)
CURL_REQUESTS=100          # peticiones HTTP por corrida
IPERF_TIME=30              # segundos por prueba iperf3
IPERF_OMIT=3               # segundos de calentamiento que iperf3 descarta

# UDP: carga ofrecida y tamaño del datagrama.
# 1200 bytes evita fragmentación dentro del túnel (la MTU de WireGuard es 1420).
UDP_BW=100M
UDP_LEN=1200

# 1 = comprobar que sin_vpn NO pasa por una interfaz WireGuard y que con_vpn SÍ.
# Dejar en 1 salvo en pruebas sintéticas.
VERIFICAR_RUTAS=1
